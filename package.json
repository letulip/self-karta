{
  "name": "self-karta",
  "private": true,
  "version": "1.0.0",
  "description": "Карта экспертности — само-интервью о сильных сторонах, энергии и направлении. Всё хранится в браузере.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "leak-check": "node scripts/leak-check.mjs"
  },
  "dependencies": {
    "vue": "3.5.40",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "happy-dom": "20.11.1",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
